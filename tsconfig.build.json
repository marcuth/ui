{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "declaration": true,
        "outDir": "./dist",
        "rootDir": "./src",
        "types": []
    },
    "include": [
        "src"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "__tests__",
        "playground"
    ],
    "tsc-alias": {
        "resolveFullPaths": true,
        "verbose": false
    }
}
